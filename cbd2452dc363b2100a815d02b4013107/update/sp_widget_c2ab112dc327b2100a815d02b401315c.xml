        <client_script><![CDATA[api.controller = function() {
  var c = this;
  c.getBadgeClass = function(index) {
    if (index === 0) return 'label label-primary';
    if (index === 1) return 'label label-success';
    if (index === 2) return 'label label-info';
    return 'label label-default';
