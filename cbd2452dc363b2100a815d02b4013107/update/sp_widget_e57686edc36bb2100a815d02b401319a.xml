        <template><![CDATA[<div class="prompt-record panel panel-default">
  <div class="panel-heading">
    <h3 class="panel-title">
      <span class="fa fa-file-text-o m-r-xs"></span>
      Prompt details
    </h3>
  </div>

  <div class="panel-body" ng-if="data.error">
    <div class="alert alert-warning m-b-0">
      {{::data.error}}
    </div>
  </div>

  <div class="panel-body" ng-if="!data.error && !c.hasRecord()">
    <div class="text-center text-muted">
      <span class="fa fa-spinner fa-spin m-r-xs"></span>
      Loading record...
    </div>
  </div>

  <div class="panel-body" ng-if="!data.error && c.hasRecord()">
    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label class="control-label text-muted">User</label>
          <div class="form-control-static">
            <span class="fa fa-user m-r-xs"></span>{{::data.record.user || 'Anonymous'}}
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label class="control-label text-muted">KB Article</label>
          <div class="form-control-static">
            <span class="fa fa-book m-r-xs"></span>{{::data.record.article || 'No KB linked'}}
          </div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label class="control-label text-muted">Created on</label>
          <div class="form-control-static">
            <span class="fa fa-clock-o m-r-xs"></span>{{::data.record.created_on}}
          </div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label class="control-label text-muted">Last updated</label>
          <div class="form-control-static">
            <span class="fa fa-refresh m-r-xs"></span>{{::data.record.updated_on}}
          </div>
        </div>
      </div>
    </div>

    <hr/>

    <div class="form-group" ng-if="data.record.summary">
      <label class="control-label text-muted">Summary</label>
      <div class="well well-sm">
        {{::data.record.summary}}
      </div>
    </div>

    <div class="form-group">
      <label class="control-label text-muted">Prompt</label>
      <textarea class="form-control" rows="5" readonly>{{::data.record.prompt}}</textarea>
    </div>

    <div class="form-group">
      <label class="control-label text-muted">Result</label>
      <textarea class="form-control" rows="8" readonly>{{::data.record.result}}</textarea>
    </div>
  </div>
</div>]]></template>
