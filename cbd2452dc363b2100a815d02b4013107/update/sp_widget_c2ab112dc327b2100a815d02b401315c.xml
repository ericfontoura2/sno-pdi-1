        <template><![CDATA[<div class="panel panel-default prompt-widget">
  <div class="panel-heading">
    <h3 class="panel-title">
      <span class="fa fa-magic m-r-xs"></span>
      Recent prompts
    </h3>
  </div>
  <div class="panel-body" ng-if="!data.records || data.records.length === 0">
    <div class="text-muted text-center">
      <span class="fa fa-inbox fa-2x m-b-sm"></span>
      <div>No prompts available to display.</div>
    </div>
  </div>
  <div class="list-group list-group-flush" ng-if="data.records && data.records.length">
    <a class="list-group-item" ng-repeat="r in data.records track by r.sys_id">
      <div class="clearfix m-b-xs">
        <span class="pull-left text-muted">
          <span class="fa fa-user m-r-xs"></span>{{::r.user || 'Anonymous'}}
        </span>
        <span class="pull-right text-muted">
          <span class="fa fa-clock-o m-r-xs"></span>{{::r.created_on}}
        </span>
      </div>
      <div class="m-b-xs">
        <span class="label label-info m-r-xs" ng-if="r.article">KB: {{::r.article}}</span>
        <span class="label label-default" ng-if="!r.article">No KB linked</span>
      </div>
      <div class="prompt-summary m-b-xs" ng-if="r.summary">
        {{::r.summary}}
      </div>
      <div class="prompt-text text-muted" ng-if="!r.summary">
        {{::r.prompt}}
      </div>
      <div class="prompt-result m-t-sm">
        <div class="text-uppercase text-muted small m-b-xxs">Result</div>
        <div class="well well-sm m-b-0">
          {{::r.result}}
        </div>
      </div>
    </a>
  </div>
</div>]]></template>
    </sp_widget>
