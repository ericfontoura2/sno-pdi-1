        <name>Prompt</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {
  // Server script: load prompt records for portal
  data.records = [];

  var gr = new GlideRecord('x_107457_test_prompt');
  gr.addQuery('display_on_portal', true);
  gr.orderByDesc('sys_created_on');
  gr.query();

  while (gr.next()) {
    data.records.push({
      sys_id: gr.getUniqueValue(),
      created_on: gr.getDisplayValue('sys_created_on'),
      user: gr.getDisplayValue('user'),
      article: gr.getDisplayValue('article'),
      prompt: gr.getDisplayValue('prompt'),
      result: gr.getDisplayValue('result'),
      summary: gr.getDisplayValue('summary')
    });
  }
})();]]></script>
