    <sp_widget action="INSERT_OR_UPDATE">
        <category>custom</category>
        <client_script><![CDATA[api.controller = function() {
  var c = this;
  c.hasRecord = function() {
    return !!c.data.record && !!c.data.record.sys_id;
  };
};]]></client_script>
        <controller_as>c</controller_as>
