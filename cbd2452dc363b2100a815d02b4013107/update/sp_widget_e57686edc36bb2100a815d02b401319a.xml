        <name>Prompt Record</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {
  // Read sys_id from URL: /sp?id=prompt_record&sys_id=...
  data.record = {};
  var sysId = $sp.getParameter('sys_id');

  if (!sysId) {
    data.error = 'No record specified.';
    return;
  }

  var gr = new GlideRecord('x_107457_test_prompt');
  if (!gr.get(sysId)) {
    data.error = 'Prompt record not found.';
    return;
  }

  data.record = {
    sys_id: gr.getUniqueValue(),
    number: gr.getDisplayValue('number') || '',
    user: gr.getDisplayValue('user'),
    article: gr.getDisplayValue('article'),
    prompt: gr.getDisplayValue('prompt'),
    result: gr.getDisplayValue('result'),
    summary: gr.getDisplayValue('summary'),
    created_on: gr.getDisplayValue('sys_created_on'),
    updated_on: gr.getDisplayValue('sys_updated_on')
  };
})();]]></script>
